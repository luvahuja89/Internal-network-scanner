# =============================================================================
# Internal Network Scanner — Environment Configuration Template
# Copy this file to .env: cp .env.example .env
# =============================================================================

# 1. Target Subnet Scope (Optional: Comma-separated CIDRs. If unset, uses config/config.yaml or auto-detect)
# TARGET_CIDR=192.168.1.0/24,10.0.10.0/24,172.16.0.0/24

# 2. Scan Profile (wellknown_os, fast, standard, deep)
SCAN_PROFILE=wellknown_os

# 3. Maximum Packet Rate (packets per second - default 100 pps is gentle & fast)
MAX_PACKET_RATE=100

# 4. Recurring Cron Schedule (Default: 0 2 1 * * = Monthly on 1st at 2:00 AM)
CRON_SCHEDULE=0 2 1 * *

# 5. AWS S3 Report Synchronization (Optional)
# Specify bucket name to automatically enable S3 report uploads
S3_BUCKET_NAME=your-company-network-reports-bucket
AWS_DEFAULT_REGION=us-east-1

# AWS IAM Credentials (Leave empty if running on EC2/EKS with IAM Instance Profile / Role)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
